# RESONANCE configuration. Copy to .env (never commit .env). Every value is optional.
RESONANCE_DATA_DIR=./data                 # database + stored audio. Back this folder up.
# RESONANCE_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/resonance   # default: SQLite inside DATA_DIR
RESONANCE_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2   # any GM .sf2/.sf3; a better SoundFont = better instrument sound
RESONANCE_MAX_UPLOAD_MB=200
RESONANCE_JOB_MAX_ATTEMPTS=2              # automatic retries for a failing agent
RESONANCE_ALLOW_REGISTRATION=1            # set 0 after creating your account on a shared server
RESONANCE_COOKIE_SECURE=0                 # set 1 when served over HTTPS
RESONANCE_DEMUCS_MODEL=htdemucs
# RESONANCE_DEMUCS_REPO=/models/demucs    # folder with pre-downloaded Demucs weights, for offline servers
# The optional Anthropic key for plain-English summaries is entered in the app (Engines & settings),
# stored server-side, and never returned to the browser. Do not put API keys in this file's repo copy.
